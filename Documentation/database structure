## RLS Policy Expressions (Supabase Dashboard Reference)

### user_profiles
SELECT: `id = auth.uid()`
UPDATE USING + WITH CHECK: `id = auth.uid()`

### orgs
SELECT: `id = (select org_id from user_profiles where id = auth.uid())`

### officials
SELECT:
`org_id = (select org_id from user_profiles where id = auth.uid())`

WRITE (manager/admin):
`org_id = (select org_id from user_profiles where id = auth.uid())
and (select role from user_profiles where id = auth.uid()) in ('manager','admin')`

### games
SELECT (must be member):
`exists (select 1 from game_members gm where gm.game_id = games.id and gm.profile_id = auth.uid())`

INSERT:
`created_by = auth.uid()
and org_id = (select org_id from user_profiles where id = auth.uid())`

UPDATE/DELETE (editors):
`exists (select 1 from game_members gm where gm.game_id = games.id and gm.profile_id = auth.uid() and gm.access_level = 'editor')`

### game_members
SELECT (member can see):
`exists (select 1 from game_members gm where gm.game_id = game_members.game_id and gm.profile_id = auth.uid())`

INSERT/UPDATE/DELETE (editors of that game):
`exists (select 1 from game_members gm where gm.game_id = game_members.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')`

### game_officials
SELECT:
`exists (select 1 from game_members gm where gm.game_id = game_officials.game_id and gm.profile_id = auth.uid())`
WRITE (editors):
`exists (select 1 from game_members gm where gm.game_id = game_officials.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')`

### game_clock
SELECT:
`exists (select 1 from game_members gm where gm.game_id = game_clock.game_id and gm.profile_id = auth.uid())`
UPDATE (editors):
`exists (select 1 from game_members gm where gm.game_id = game_clock.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')`

### incident_types
SELECT:
`org_id = (select org_id from user_profiles where id = auth.uid())`
WRITE (manager/admin):
`org_id = (select org_id from user_profiles where id = auth.uid())
and (select role from user_profiles where id = auth.uid()) in ('manager','admin')`

### incident_options
SELECT:
`exists (select 1 from incident_types it
  where it.id = incident_options.incident_type_id
  and it.org_id = (select org_id from user_profiles where id = auth.uid()))`

WRITE (manager/admin):
`(select role from user_profiles where id = auth.uid()) in ('manager','admin')
and exists (select 1 from incident_types it
  where it.id = incident_options.incident_type_id
  and it.org_id = (select org_id from user_profiles where id = auth.uid()))`

### incidents
SELECT:
`exists (select 1 from game_members gm where gm.game_id = incidents.game_id and gm.profile_id = auth.uid())
and deleted_at is null`

INSERT:
`exists (select 1 from game_members gm where gm.game_id = incidents.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')
and created_by = auth.uid()
and org_id = (select org_id from games where id = incidents.game_id)`

UPDATE:
`exists (select 1 from game_members gm where gm.game_id = incidents.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')`

DELETE: not used (soft delete via deleted_at)

### incident_targets
SELECT:
`exists (
  select 1 from incidents i
  join game_members gm on gm.game_id = i.game_id
  where i.id = incident_targets.incident_id
  and gm.profile_id = auth.uid()
  and i.deleted_at is null
)`

WRITE:
`exists (
  select 1 from incidents i
  join game_members gm on gm.game_id = i.game_id
  where i.id = incident_targets.incident_id
  and gm.profile_id = auth.uid()
  and gm.access_level = 'editor'
)`

### incident_audio
SELECT:
`exists (
  select 1 from incidents i
  join game_members gm on gm.game_id = i.game_id
  where i.id = incident_audio.incident_id
  and gm.profile_id = auth.uid()
  and i.deleted_at is null
)`

WRITE:
`exists (
  select 1 from incidents i
  join game_members gm on gm.game_id = i.game_id
  where i.id = incident_audio.incident_id
  and gm.profile_id = auth.uid()
  and gm.access_level = 'editor'
)`

### reports
SELECT:
`exists (select 1 from game_members gm where gm.game_id = reports.game_id and gm.profile_id = auth.uid())`

INSERT:
`exists (select 1 from game_members gm where gm.game_id = reports.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')
and author_id = auth.uid()
and org_id = (select org_id from games where id = reports.game_id)`

UPDATE (author only):
`author_id = auth.uid()
and exists (select 1 from game_members gm where gm.game_id = reports.game_id and gm.profile_id = auth.uid() and gm.access_level = 'editor')`

### report_ai_drafts
SELECT:
`exists (
  select 1 from reports r
  join game_members gm on gm.game_id = r.game_id
  where r.id = report_ai_drafts.report_id
  and gm.profile_id = auth.uid()
)`

WRITE (author only):
`exists (
  select 1 from reports r
  join game_members gm on gm.game_id = r.game_id
  where r.id = report_ai_drafts.report_id
  and r.author_id = auth.uid()
  and gm.profile_id = auth.uid()
  and gm.access_level = 'editor'
)`

### report_templates / report_sections
Same pattern as incident definitions:
- SELECT scoped to org
- WRITE manager/admin

### report_section_entries
SELECT:
`exists (
  select 1 from reports r
  join game_members gm on gm.game_id = r.game_id
  where r.id = report_section_entries.report_id
  and gm.profile_id = auth.uid()
)`

UPDATE (author only):
`exists (
  select 1 from reports r
  join game_members gm on gm.game_id = r.game_id
  where r.id = report_section_entries.report_id
  and r.author_id = auth.uid()
  and gm.profile_id = auth.uid()
